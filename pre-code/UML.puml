@startuml
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false

class camera {
    - position : glm::vec3
    - front : glm::vec3
    - up : glm::vec3
    - yaw : float
    - pitch : float
    - speed : float
    - sensitivity : float
    + camera(startPosition : glm::vec3, startUp : glm::vec3, startYaw : float, startPitch : float)
    + processKeyboardInput(window : GLFWwindow*, deltaTime : float) : void
    + processMouseMovement(xoffset : float, yoffset : float) : void
    + getViewMatrix() : glm::mat4
}

class Editor3D {
    
}

class Face {
    - halfedge : HalfEdge*
    + getHalfEdge() : HalfEdge*
    + setHalfEdge(he : HalfEdge*) : void
}

class HalfEdge {
    - target : Vertex*
    - next : HalfEdge*
    - twin : HalfEdge*
    - face : Face*
    + Target() : Vertex*
    + Next() : HalfEdge*
    + Twin() : HalfEdge*
    + getFace() : Face*
    + setTarget(vtx : Vertex*) : void
    + setNext(he : HalfEdge*) : void
    + setTwin(he : HalfEdge*) : void
    + setFace(newface : Face*) : void
}

abstract class Loader {
    # tabPoint : std::vector<std::vector<float>>
    # tabFace : std::vector<std::vector<int>>
    + {abstract} LoadFile(filePath : std::string) : void = 0
    + GetPoints() : const std::vector<std::vector<float>>&
    + GetFaces() : const std::vector<std::vector<int>>&
}

class Mesh {
    - tabVertex : std::vector<Vertex*>
    - tabFace : std::vector<Face*>
    - tabHE : std::vector<HalfEdge*>
    + Mesh(V : std::vector<std::vector<float>>, F : std::vector<std::vector<int>>)
    + ~Mesh()
    + addVertex(newvertex : Vertex*) : void
    + addFace(newface : Face*) : void
    + getVertices() : const std::vector<Vertex*>&
    + getFaces() : const std::vector<Face*>&
    + getHalfEdges() : const std::vector<HalfEdge*>&
}

class ObjLoader {
    + LoadFile(filePath : std::string) : void override
}

class PlyLoader {
    + LoadFile(filePath : std::string) : void override
}

class Scene {
    - vertexShaderSource : const char*
    - fragmentShaderSource : const char*
    - windowPtr : GLFWwindow*
    - cam : camera
    - lastX : float
    - lastY : float
    - firstMouse : bool
    - framebuffer_size_callback(window : GLFWwindow*, width : int, height : int) : void
    - {static} key_callback(window : GLFWwindow*, key : int, scancode : int, action : int, mods : int) : void
    - {static} mouse_callback(window : GLFWwindow*, xposIn : double, yposIn : double) : void
    + Scene()
    + window() : void
    + update() : void
    + draw(halfEdges : std::vector<HalfEdge*>, window : GLFWwindow*) : void
    + getwindow() : GLFWwindow*
    + getCamera() : camera&
}

class Vertex {
    - x : float
    - y : float
    - z : float
    - halfedge : HalfEdge*
    + getPosition() : std::array<float, 3>
    + getHalfEdge() : HalfEdge*
    + setPosition(newX : float, newY : float, newZ : float) : void
    + setHalfEdge(he : HalfEdge*) : void
}

' Relations
Loader <|-- ObjLoader : hérite
Loader <|-- PlyLoader : hérite
Mesh o-- Vertex : tabVertex
Mesh o-- Face : tabFace
Mesh o-- HalfEdge : tabHE
Face --> HalfEdge : halfedge
Vertex --> HalfEdge : halfedge
HalfEdge --> Vertex : target
HalfEdge --> HalfEdge : next / twin
HalfEdge --> Face : face
Scene *-- camera : cam

@enduml